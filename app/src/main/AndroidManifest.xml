<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 必要权限：v0.1 骨架先列出来，Phase 3 通知 / Phase 4 备份会真正用到 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 只声明 SCHEDULE_EXACT_ALARM（用户可撤回，scheduler 有 inexact 降级分支）；
         USE_EXACT_ALARM 是自动授予但 Play 政策仅限闹钟/日历类核心应用，v0.4.1 移除 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WakePlan"
        tools:targetApi="35">

        <!-- singleTop：通知 / widget 的 PendingIntent 走 onNewIntent 复用实例，
             不销毁重建（v0.4.1 前没设，CLEAR_TOP 会把导航栈整个打掉） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WakePlan.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 任务 starting 闹钟接收器 — Phase 3.2
             PendingIntent 用显式 Intent（组件名匹配），exported=false 即可，
             三方 app 无法伪造 ACTION_TASK_STARTING 触发伪造通知 -->
        <receiver
            android:name=".notification.StartingAlarmReceiver"
            android:exported="false" />

        <!-- 系统重启 / 时间变更 / App 更新后重排 starting 闹钟 — v0.4
             AlarmManager 闹钟不跨重启与自更新；以下都是受保护广播（仅系统可发），
             exported=false 防三方伪造，系统投递不受影响 -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 今日 mini timeline 桌面小组件 — Phase 5.6
             AppWidgetProvider 系统会主动 broadcast（widget update / enable） -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Quick Settings Tile — Phase 5.7
             点击 tile 启动 MainActivity + emit NavEventBus.NavToToday → 跳 Today tab
             system 主动 bind 这个 service（BIND_QUICK_SETTINGS_TILE permission） -->
        <service
            android:name=".widget.WakePlanTileService"
            android:label="@string/app_name"
            android:icon="@drawable/widget_background"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- 禁用 WorkManager 自动初始化 — App.onCreate 用 HiltWorkerFactory 手动初始化
             （让 @HiltWorker 注解的 Worker 拿到 Hilt 注入的依赖） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Per-app locale storage — v0.3
             androidx.appcompat 提供的 holder service，让 Android 13+ system locale picker
             能发现本 App 支持的语言（zh-CN / en），并把用户选择持久化 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
